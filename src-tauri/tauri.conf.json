{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sponos",
  "version": "../package.json",
  "identifier": "com.casperjuel.sonosui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sponos",
        "width": 1320,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "A nicer Sonos controller with Spotify search",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBRDM3MDVCQzJFNzY5RjQKUldUMGFlZkNXM0RUdXFaR2FMWjNhZFVCM1pKd0U4a1hod0ZsR2dLeDRaWG1YcUUrT2JQdmZMQXMK",
      "endpoints": [
        "https://github.com/casperjuel/sponos/releases/latest/download/latest.json"
      ]
    }
  }
}
